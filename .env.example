# Which database to use: "local" (MySQL on this computer) or "deployed" (Aiven)
APP_ENV=local

# ---- Local MySQL (used when APP_ENV=local) ----
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=stitchbook_user
LOCAL_DB_PASSWORD=stitchbook_pass
LOCAL_DB_NAME=stitchbook

# ---- Aiven MySQL (used when APP_ENV=deployed) ----
# Get these from the Aiven console.
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_USER=
AIVEN_DB_PASSWORD=
AIVEN_DB_NAME=
AIVEN_SSL_CA=certs/ca.pem
